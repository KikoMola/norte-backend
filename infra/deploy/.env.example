# Variables de producción. Copia este fichero a `.env` en el servidor (junto a compose.prod.yaml) y rellénalo.
# Genera contraseñas largas y aleatorias, por ejemplo: openssl rand -base64 32
# El fichero .env nunca se sube al repositorio.

# --- Dominios y TLS (Caddy pide los certificados a Let's Encrypt) ---
NORTE_DOMAIN=norte.example.com
AUTH_DOMAIN=auth.norte.example.com
FILES_DOMAIN=files.norte.example.com
ACME_EMAIL=admin@example.com

# --- Versiones de las imágenes (tag de GHCR: latest o sha-<commit>) ---
BACKEND_TAG=latest
FRONTEND_TAG=latest

# --- PostgreSQL ---
POSTGRES_PASSWORD=
# Dueño de las tablas de Norte (Flyway).
DB_OWNER_PASSWORD=
# Usuario de la aplicación (sin BYPASSRLS).
DB_APP_PASSWORD=
# Base de datos de Keycloak.
KC_DB_PASSWORD=

# --- Keycloak ---
# Administrador temporal del primer arranque: crea uno definitivo y borra este.
KC_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=
# Secreto del cliente de servicio norte-provisioner (Clients > norte-provisioner > Credentials). Lo usa el comando
# provision-tenant para crear la organización y el primer administrador de cada tenant.
KEYCLOAK_PROVISIONER_SECRET=

# --- Ficheros (SeaweedFS) ---
# Clave del usuario norte-app del almacén de ficheros.
FILES_SECRET_KEY=

# --- Correo (SMTP del proveedor: Brevo, Mailgun, Amazon SES, el de tu dominio…) ---
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Remitente de todos los correos. Su dominio debe tener SPF y DKIM del proveedor o los correos acabarán en spam.
MAIL_FROM=no-reply@norte.example.com

# --- BFF ---
# Secreto del cliente confidencial norte-bff del realm norte (Keycloak > Clients > norte-bff > Credentials).
BFF_CLIENT_SECRET=

# --- Observabilidad ---
# Fracción de peticiones con traza completa (0.0 a 1.0).
TRACING_SAMPLING_PROBABILITY=0.2

# --- Copias de seguridad a S3 ---
BACKUP_TIME=03:00
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=norte
BACKUP_S3_REGION=eu-west-1
# Vacío para AWS; la URL del servicio para un S3 compatible (Scaleway, Hetzner…).
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
